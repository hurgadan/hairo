APP_NAME=hairo

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_LOGIN=postgres
DB_PASSWORD=123123
DB_NAME=hairo
DB_ENABLE_LOGGING=false

RECIPIENT=
# Токен бота от @BotFather. Пусто — бот не поднимается вовсе: приложение
# работает как раньше, уведомления в Telegram просто не уходят.
TELEGRAM_BOT_TOKEN=

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# S3-совместимое хранилище (dev: MinIO из docker-compose)
# prod: Cloudflare R2 (endpoint https://<account>.eu.r2.cloudflarestorage.com,
#       region=auto, FORCE_PATH_STYLE=false, PUBLIC_URL=CDN-домен бакета)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY_ID=hairo
STORAGE_SECRET_ACCESS_KEY=hairo_dev_secret
STORAGE_BUCKET=hairo-photos
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=

# Отправка писем. MAIL_PROVIDER: log (печатать в лог, дефолт) | smtp
# dev: Mailpit из docker-compose (`db:up`) — SMTP :1025, веб-интерфейс :8025
# prod: SMTP-креды провайдера (Mailgun/Postmark/Resend), EU-регион под GDPR
MAIL_PROVIDER=smtp
MAIL_FROM="Hairo <noreply@hairo.local>"
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# Модель генерации изображений (Nano Banana / Gemini 2.5 Flash Image)
IMAGE_MODEL=gemini-2.5-flash-image
# Модель для structured vision-анализа фото (face-analysis)
LLM_MODEL=gemini-2.5-flash
GOOGLE_AI_API_KEY=
